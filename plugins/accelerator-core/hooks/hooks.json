{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/speak.sh --active",
            "description": "speak-aloud: mark this session active and stop any prior speech (barge-in)",
            "id": "userpromptsubmit:speak-aloud-active"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/speak.sh",
            "description": "speak-aloud: speak the latest reply (active session only, latest wins)",
            "id": "stop:speak-aloud"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/speak.sh --cancel",
            "description": "speak-aloud: stop speech when the session ends",
            "id": "sessionend:speak-aloud-cancel"
          }
        ]
      }
    ]
  }
}
